#!/bin/sh /etc/rc.common
# SPDX-FileCopyrightText: 2026 amurcanov / SkyPass
# CSQTT 2.5.0 procd init script for OpenWrt

START=99
STOP=15
USE_PROCD=1

CSQTT_BIN="/usr/bin/csqtt-core"
CSQTT_PROG="csqtt"
CSQTT_RUN_DIR="/var/run/csqtt"
CSQTT_STATUS="/var/run/csqtt/status.json"

start_service() {
	if [ ! -x "$CSQTT_BIN" ]; then
		echo "csqtt: $CSQTT_BIN not found or not executable" >&2
		return 1
	fi

	local enabled active_prof peer password workers obfs turn_transport vk tun_mtu ifname
	enabled=$(uci -q get csqtt.main.enabled || echo 1)
	if [ "$enabled" = "0" ]; then
		echo "csqtt: service disabled in config" >&2
		return 0
	fi

	active_prof=$(uci -q get csqtt.main.active_profile || echo profile1)
	peer=$(uci -q get csqtt.${active_prof}.peer)
	password=$(uci -q get csqtt.${active_prof}.password)
	workers=$(uci -q get csqtt.${active_prof}.workers || uci -q get csqtt.main.workers || echo 10)
	obfs=$(uci -q get csqtt.${active_prof}.obfs || uci -q get csqtt.main.obfs || echo video)
	turn_transport=$(uci -q get csqtt.${active_prof}.turn_transport || uci -q get csqtt.main.turn_transport || echo udp)
	vk=$(uci -q get csqtt.main.vk)
	tun_mtu=$(uci -q get csqtt.main.tun_mtu || echo 1300)
	ifname=$(uci -q get csqtt.main.ifname || echo csqtt0)

	if [ -z "$peer" ] || [ -z "$password" ]; then
		echo "csqtt: profile $active_prof missing peer or password" >&2
		return 1
	fi

	mkdir -p "$CSQTT_RUN_DIR" 2>/dev/null
	chmod 755 "$CSQTT_RUN_DIR" 2>/dev/null
	[ -e /dev/net/tun ] || modprobe tun 2>/dev/null

	procd_open_instance main
	procd_set_param command "$CSQTT_BIN" \
		--peer "$peer" \
		--vk "$vk" \
		--workers "$workers" \
		--obfs "$obfs" \
		--turn-transport "$turn_transport" \
		--tun "$ifname" \
		--tun-mtu "$tun_mtu"
	procd_set_param env CSQTT_PASSWORD="$password"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/csqtt
	procd_close_instance
}

stop_service() {
	local ifname
	ifname=$(uci -q get csqtt.main.ifname || echo csqtt0)
	rm -f "$CSQTT_STATUS" "${CSQTT_STATUS}.tmp"
	ip link del dev "$ifname" 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger "$CSQTT_PROG"
}

reload_service() {
	stop
	start
}
